# Copia este archivo a ".env" y completa los valores.
# OJO: ".env" se empaqueta dentro de la app (está declarado en pubspec.yaml como
# asset), así que aquí SOLO van claves públicas. Nunca pongas claves secretas
# (por ejemplo la "sk_..." de Stripe): esas viven únicamente en tu servidor.

# Clave pública de Stripe (empieza con pk_test_ o pk_live_)
STRIPE_PUBLISHABLE_KEY=

# ID de cliente web de Google (para Google Sign-In)
GOOGLE_SERVER_CLIENT_ID=
